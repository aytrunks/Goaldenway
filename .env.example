# Higgsfield API credentials.
# Copy to .env and fill in real values. .env is gitignored - never commit secrets.
# Find these at https://console.higgsfield.ai (API keys).
#
# Auth is one header: `Authorization: Key KEY_ID:KEY_SECRET`.
# BOTH halves are required; a key id alone returns 401.

HF_API_KEY_ID=your_key_id_here
HF_API_KEY_SECRET=your_key_secret_here

# The official SDKs read the combined form instead. Either works:
# HF_KEY="your_key_id_here:your_key_secret_here"          # Python / cURL
# HF_CREDENTIALS="your_key_id_here:your_key_secret_here"  # TypeScript

# Optional overrides.
# HIGGSFIELD_API_BASE=https://api.higgsfield.ai
# HIGGSFIELD_LEDGER=.higgsfield/ledger.json
